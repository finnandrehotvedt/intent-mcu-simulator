FROM node:20.19.4-alpine3.22@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799

RUN apk add --no-cache docker-cli=28.3.3-r5
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY . ./
RUN npm run build

ENV HOME=/tmp NO_UPDATE_NOTIFIER=1 \
    STAGING_HOST=0.0.0.0 STAGING_PORT=18766 \
    COMPILER_IMAGE_LOCK=/workspace/compiler/local-image-lock.json \
    DEPLOYMENT_SCOPE=local-source
USER node
CMD ["npm", "run", "start:local"]
