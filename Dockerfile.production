FROM local/intent-mcu-compiler-integration:1.0.0-rc.2 AS dockercli
FROM local/intent-mcu-source-check:1.1.0-rc.15

ARG RELEASE_COMMIT

LABEL org.opencontainers.image.title="Intent MCU Simulator production" \
      org.opencontainers.image.version="1.1.0-rc.15" \
      org.opencontainers.image.revision="${RELEASE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/finnandrehotvedt/intent-mcu-simulator" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT"

USER root
COPY --from=dockercli /usr/bin/docker /usr/bin/docker
RUN test "$(docker --version)" = "Docker version 28.3.3, build 980b85681696fbd95927fd8ded8f6d91bdca95b0" \
    && chmod 0555 /usr/bin/docker \
    && find /workspace/dist -type d -exec chmod 0555 {} + \
    && find /workspace/dist -type f -exec chmod 0444 {} + \
    && chmod -R a+rX /workspace/c3 /workspace/stm32 \
    && chmod 0444 /workspace/staging/server.mjs /workspace/compiler/*.mjs /workspace/compiler/*.json

USER node
CMD ["node", "staging/server.mjs"]
