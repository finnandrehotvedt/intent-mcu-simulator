FROM local/intent-mcu-source-check:1.1.0-rc.48

# X26 changes scripts and project source only; package-lock.json is unchanged.
# Reuse the checksum-locked rc.48 dependency layer so private candidate builds
# remain available when the external npm registry is unavailable.
USER root
WORKDIR /workspace
COPY . ./
RUN npm run build \
    && npm run test:x26 \
    && chmod -R a+rX /workspace

ENV HOME=/tmp NO_UPDATE_NOTIFIER=1 \
    STAGING_HOST=0.0.0.0 STAGING_PORT=18766 \
    COMPILER_IMAGE_LOCK=/workspace/compiler/local-image-lock.json \
    RP2040_COMPILER_IMAGE_LOCK=/workspace/compiler/local-rp2040-image-lock.json \
    DEPLOYMENT_SCOPE=local-source
USER node
CMD ["npm", "run", "start:local"]
