FROM local/intent-mcu-x26:1.1.0-rc.48-private

# Reuse the checksum-locked dependency layer; X27 changes project source only.
USER root
WORKDIR /workspace
COPY . ./
RUN npm run build \
    && npm run test:x27 \
    && chmod -R a+rX /workspace

ENV HOME=/tmp NO_UPDATE_NOTIFIER=1 \
    STAGING_HOST=0.0.0.0 STAGING_PORT=18766 \
    COMPILER_IMAGE_LOCK=/workspace/compiler/local-image-lock.json \
    RP2040_COMPILER_IMAGE_LOCK=/workspace/compiler/local-rp2040-image-lock.json \
    DEPLOYMENT_SCOPE=local-source
USER node
CMD ["npm", "run", "start:local"]
