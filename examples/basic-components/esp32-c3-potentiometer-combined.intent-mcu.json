{
  "schema": "intent-mcu-esp32c3-public-project@1",
  "name": "esp32-c3 combined potentiometer authoring",
  "profile": "board.esp32-c3-devmodule-v1",
  "source": "// Copyright 2026 IntentForce\n// SPDX-License-Identifier: Apache-2.0\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(2, OUTPUT);\n  digitalWrite(2, HIGH);\n  Serial.println(\"C3_PUBLIC\");\n}\n\nvoid loop() {\n  delay(1000);\n}\n",
