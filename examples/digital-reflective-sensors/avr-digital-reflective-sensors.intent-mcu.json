          {
            "name": "main.ino",
            "content": "void setup(){\n  Serial.begin(115200);\n  pinMode(7, INPUT_PULLUP); pinMode(8, INPUT_PULLUP);\n}\nvoid loop(){\n  bool obstacle = digitalRead(7) == LOW;\n  bool line = digitalRead(8) == LOW;\n  Serial.print(\"obstacle=\"); Serial.print(obstacle);\n  Serial.print(\",line=\"); Serial.println(line);\n  delay(120);\n}\n"
          }
