      "source": {
        "files": [
          {
            "name": "main.ino",
            "content": "const byte rows[4]={2,3,4,5}; const byte cols[4]={6,7,8,9};\nvoid setup(){Serial.begin(115200);for(byte r:rows){pinMode(r,OUTPUT);digitalWrite(r,HIGH);}for(byte c:cols)pinMode(c,INPUT_PULLUP);}\nvoid loop(){for(byte r=0;r<4;r++){digitalWrite(rows[r],LOW);for(byte c=0;c<4;c++)if(!digitalRead(cols[c])){Serial.print(r+1);Serial.println(c+1);}digitalWrite(rows[r],HIGH);}delay(20);}\n"
          }
        ]
