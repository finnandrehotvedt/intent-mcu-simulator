{
  "name": "intent-mcu-simulator",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "Original browser-based microcontroller learning environment source",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "20.19.4",
    "npm": "10.8.2"
  },
  "scripts": {
    "build": "node scripts/build-staging.mjs",
    "test": "node --test --test-concurrency=1 test/circuit-model.test.mjs test/lifecycle.test.mjs test/workbench-instruments.test.mjs test/gateway-unit.test.mjs",
    "setup:toolchain": "sh scripts/setup-local-toolchain.sh",
    "start:local": "node staging/server.mjs",
    "test:local": "node scripts/verify-local-compile-run.mjs",
    "test:compiler-integration": "node --test test/compiler-integration.test.mjs",
    "test:operations": "node --test test/operations-staging.test.mjs"
  },
  "dependencies": {
    "avr8js": "0.21.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
