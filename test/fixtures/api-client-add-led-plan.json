{
  "schema": "intent-mcu-browser-session-plan@1",
  "commands": [
    { "command": "component.add", "id": "api-resistor-1", "type": "resistor.fixed-v1", "position": { "x": 0.52, "y": 0.2, "rotation": 0 } },
    { "command": "component.add", "id": "api-led-1", "type": "led.basic-v1", "position": { "x": 0.76, "y": 0.3, "rotation": 0 } },
    { "command": "wire.connect", "net_id": "api-net-drive", "from": { "component": "board-1", "pin": "D12" }, "to": { "component": "api-resistor-1", "pin": "A" } },
    { "command": "wire.connect", "net_id": "api-net-series", "from": { "component": "api-resistor-1", "pin": "B" }, "to": { "component": "api-led-1", "pin": "ANODE" } },
    { "command": "wire.connect", "net_id": "api-net-ground", "from": { "component": "api-led-1", "pin": "CATHODE" }, "to": { "component": "board-1", "pin": "GND2" } }
  ]
}
